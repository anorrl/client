function starts(String,Start)
	return string.sub(String,1,string.len(Start))==Start
end

for _, v in pairs(animNames) do
	for i, j in pairs(v) do
		for i2, j2 in pairs(j) do
			if i2 == "id" then
				if starts(j[i2], "arlassetid://") then
					local id = (j[i2]:gsub("http://arl.lambda.cam/asset/%?id=", "")) 
					--preloadSound(id)
				end
			end
		end
	end
end

