TARGET        = libqtnribbon.so.3.2.1
TARGETA       = ../../../bin/libqtnribbon.a
TARGET0       = libqtnribbon.so
TARGETD       = libqtnribbon.so.3.2.1
TARGET1       = libqtnribbon.so.3
TARGET2       = libqtnribbon.so.3.2


first: all
####### Build rules

../../../bin/libqtnribbon.so.3.2.1:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d ../../../bin/ || mkdir -p ../../../bin/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../../../bin/$(TARGET)
	-$(MOVE) $(TARGET) ../../../bin/$(TARGET)
	-$(DEL_FILE) ../../../bin/$(TARGET0)
	-$(DEL_FILE) ../../../bin/$(TARGET1)
	-$(DEL_FILE) ../../../bin/$(TARGET2)
	-$(MOVE) $(TARGET0) ../../../bin/$(TARGET0)
	-$(MOVE) $(TARGET1) ../../../bin/$(TARGET1)
	-$(MOVE) $(TARGET2) ../../../bin/$(TARGET2)



staticlib: ../../../bin/libqtnribbon.a

../../../bin/libqtnribbon.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

